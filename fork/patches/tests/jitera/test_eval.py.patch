+"""Tests for the eval scorer and baseline. No live scan, no network, no gepa."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import eval._lib as lib
+from eval._lib import Baseline
+from eval.harness import build_command, find_run_dir
+from eval.score import Category, parse_cwe, score_findings
+
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    import pytest
+
+
+def test_parse_cwe_handles_strix_format() -> None:
+    assert parse_cwe("CWE-89") == 89
+    assert parse_cwe("cwe_79") == 79
+    assert parse_cwe("CWE 601") == 601
+    assert parse_cwe(None) is None
+    assert parse_cwe("not a cwe") is None
+
+
+def test_baseline_loads_and_is_well_formed() -> None:
+    baseline = Baseline.load("juice-shop")
+    assert baseline.target.startswith("http")
+    assert 0 < baseline.min_categories <= len(baseline.categories)
+    ids = [c.id for c in baseline.categories]
+    assert len(ids) == len(set(ids)), "category ids must be unique"
+
+
+_CATS = [
+    Category(id="sqli", title="SQLi", cwe=(89,), keywords=("sql injection",)),
+    Category(id="xss", title="XSS", cwe=(79,), keywords=("cross-site scripting", "xss")),
+    Category(id="idor", title="IDOR", cwe=(639,), keywords=("access control",)),
+]
+
+
+def test_match_by_cwe() -> None:
+    score = score_findings([{"title": "Login bypass", "cwe": "CWE-89"}], _CATS)
+    assert score.covered_ids == ("sqli",)
+    assert score.covered == 1
+
+
+def test_match_by_keyword_when_cwe_missing() -> None:
+    findings = [{"title": "Reflected XSS in search", "description": "cross-site scripting"}]
+    score = score_findings(findings, _CATS)
+    assert "xss" in score.covered_ids
+
+
+def test_one_finding_can_cover_only_matching_categories() -> None:
+    score = score_findings([{"title": "Stored XSS", "cwe": "CWE-79"}], _CATS)
+    assert score.covered_ids == ("xss",)
+    assert set(score.missed_ids) == {"sqli", "idor"}
+
+
+def test_unmapped_findings_are_reported() -> None:
+    score = score_findings([{"title": "Clickjacking", "cwe": "CWE-1021"}], _CATS)
+    assert score.covered == 0
+    assert score.unmapped == ("Clickjacking",)
+
+
+def test_pass_gate_is_threshold_based() -> None:
+    findings = [
+        {"title": "SQLi", "cwe": "CWE-89"},
+        {"title": "XSS", "cwe": "CWE-79"},
+    ]
+    score = score_findings(findings, _CATS)
+    assert score.covered == 2
+    assert score.passed(min_categories=2)
+    assert not score.passed(min_categories=3)
+
+
+def test_scoring_is_order_independent() -> None:
+    a = [{"title": "SQLi", "cwe": "CWE-89"}, {"title": "XSS", "cwe": "CWE-79"}]
+    b = list(reversed(a))
+    assert score_findings(a, _CATS).covered_ids == score_findings(b, _CATS).covered_ids
+
+
+def test_duplicate_findings_do_not_double_count_a_category() -> None:
+    findings = [{"title": "SQLi A", "cwe": "CWE-89"}, {"title": "SQLi B", "cwe": "CWE-89"}]
+    score = score_findings(findings, _CATS)
+    assert score.covered == 1
+    assert score.to_dict()["categories_covered"] == 1
+
+
+def test_scan_command_is_headless_and_uses_our_entry_point() -> None:
+    cmd = build_command("https://demo.owasp-juice.shop", "quick", 5.0)
+    assert cmd[1:3] == ["-m", "strix.jitera"]
+    assert "-n" in cmd
+    assert cmd[cmd.index("--target") + 1] == "https://demo.owasp-juice.shop"
+    assert cmd[cmd.index("--scan-mode") + 1] == "quick"
+    assert "--instruction-file" not in cmd
+    with_instr = build_command("https://x", "quick", 5.0, instruction_file="instructions.txt")
+    assert with_instr[with_instr.index("--instruction-file") + 1] == "instructions.txt"
+
+
+def test_find_run_dir_picks_the_run(tmp_path: Path) -> None:
+    root = tmp_path
+    assert find_run_dir(root) is None
+    (root / "strix_runs" / "run-a").mkdir(parents=True)
+    assert find_run_dir(root) == root / "strix_runs" / "run-a"
+
+
+def test_runs_in_the_same_second_keep_separate_result_files(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(lib, "RESULTS_DIR", tmp_path)
+    first = lib.record_result({"timestamp": "20260101T000000Z", "passed": True})
+    second = lib.record_result({"timestamp": "20260101T000000Z", "passed": False})
+    assert first != second
+    assert first.exists()
+    assert second.exists()
+    assert len((tmp_path / "history.jsonl").read_text().splitlines()) == 2
