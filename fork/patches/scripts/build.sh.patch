Title: Build script banner says Jitera; release binary is jitera-pentest-<version>-<target>
Why: Printed 'Strix Build Script' and named the binary strix-*, which the installer no longer downloads.
Upstream-PR: none

diff --git a/scripts/build.sh b/scripts/build.sh
index 6a6c29e34a54381a6629fafd9c9c2b4f27e46a4f..fecfaf17b118bfc1cb2d9cb6aa9606128c330a40 100755
--- a/scripts/build.sh
+++ b/scripts/build.sh
@@ -10,7 +10,7 @@ YELLOW='\033[1;33m'
 BLUE='\033[0;34m'
 NC='\033[0m' # No Color
 
-echo -e "${BLUE}🦉 Strix Build Script${NC}"
+echo -e "${BLUE}Jitera Build Script${NC}"
 echo "================================"
 
 OS="$(uname -s)"
@@ -68,7 +68,7 @@ uv run pyinstaller strix.spec --noconfirm
 RELEASE_DIR="dist/release"
 mkdir -p "$RELEASE_DIR"
 
-BINARY_NAME="strix-${VERSION}-${OS_NAME}-${ARCH_NAME}"
+BINARY_NAME="jitera-pentest-${VERSION}-${OS_NAME}-${ARCH_NAME}"
 
 if [ "$OS_NAME" = "windows" ]; then
     if [ ! -f "dist/strix.exe" ]; then
