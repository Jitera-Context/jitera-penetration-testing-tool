Title: Scan log is named after the brand (jitera_pentest.log), and so are its loggers
Why: Every run folder held strix.log, and every line in it named its logger strix.<module> (strix.report.state).
Upstream-PR: none

diff --git a/strix/telemetry/logging.py b/strix/telemetry/logging.py
index 40391cc14952590802352a4dce19e67095c35f82..f7c0d15294e308cf7c516d99239f7c264d1a619d 100644
--- a/strix/telemetry/logging.py
+++ b/strix/telemetry/logging.py
@@ -135,9 +135,12 @@ def _debug_enabled(debug: bool | None) -> bool:
     return (os.environ.get("STRIX_DEBUG") or "").strip().lower() in {"1", "true", "yes", "on"}
 
 
+from strix.jitera import brand  # noqa: E402  (Jitera fork)
+
+
 def _stream_handler(debug: bool) -> logging.Handler:
     handler = _CurrentStderrHandler(logging.DEBUG if debug else logging.ERROR)
-    handler.setFormatter(logging.Formatter(_FORMAT, datefmt=_DATEFMT))
+    handler.setFormatter(brand.LogFormatter(_FORMAT, datefmt=_DATEFMT))
     handler.addFilter(_StrixContextFilter())
     handler.addFilter(_StdoutQuietFilter())
     setattr(handler, _STREAM_TAG, True)
@@ -179,11 +182,11 @@ def setup_scan_logging(run_dir: Path, *, debug: bool | None = None) -> Callable[
     debug = _debug_enabled(debug)
 
     run_dir.mkdir(parents=True, exist_ok=True)
-    log_path = run_dir / "strix.log"
+    log_path = run_dir / brand.current().log_file_name
 
     file_handler = logging.FileHandler(log_path, mode="a", encoding="utf-8")
     file_handler.setLevel(logging.DEBUG)
-    file_handler.setFormatter(logging.Formatter(_FORMAT, datefmt=_DATEFMT))
+    file_handler.setFormatter(brand.LogFormatter(_FORMAT, datefmt=_DATEFMT))
     file_handler.addFilter(_StrixContextFilter())
     setattr(file_handler, _HANDLER_TAG, True)
 
