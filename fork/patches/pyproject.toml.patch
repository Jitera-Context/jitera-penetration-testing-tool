Title: `jitera-pentest` is the only command; make eval/ importable in tests
Why: Engineers and the wheel start Jitera through strix.jitera.bootstrap. Not `jitera`: that is the Jitera Gateway CLI. The upstream `strix` command is not installed: it skipped the bootstrap (telemetry on, Strix Cloud allowed) and shadowed a real Strix install. pytest pythonpath lets tests/jitera import the eval/ harness.
Upstream-PR: none

diff --git a/pyproject.toml b/pyproject.toml
index 731da7791bc80090f65861d10dc495f4dbf31ac9..c55a14a8db7f8b08b8f047a704da12e90813674e 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -55,7 +55,7 @@ dependencies = [
 ]
 
 [project.scripts]
-strix = "strix.interface.main:main"
+jitera-pentest = "strix.jitera.bootstrap:main"
 
 [dependency-groups]
 dev = [
@@ -72,6 +72,8 @@ dev = [
 
 [tool.pytest.ini_options]
 asyncio_mode = "auto"
+# Jitera fork: make the top-level eval/ package importable from tests/jitera.
+pythonpath = ["."]
 
 [tool.uv]
 # Supply-chain cooldown: resolve only distributions that have been on the index for
