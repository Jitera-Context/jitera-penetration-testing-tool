Upstream-PR: none

diff --git a/strix/interface/tui/internal/app/setup.go b/strix/interface/tui/internal/app/setup.go
index 9b1b17a9cae4fb9b830ac0d9394026e0f285535d..f8370f0f29c4a1d1f7f1e2e192e3715247b3b7d9 100644
