         text=True,
         check=True,
     )
-    assert installed_result.stdout.strip() == f"strix {RELEASE_VERSION}"
+    assert installed_result.stdout.strip() == f"jitera-pentest {RELEASE_VERSION}"
 
 
 def test_installer_rejects_unsupported_architecture(tmp_path: Path) -> None:
