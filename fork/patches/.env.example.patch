diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000000000000000000000000000000000000..6f055cb56ba5554ba36afb9d86580950a7bf9bd1
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,55 @@
+# jitera-pentest settings. Copy this file and fill it in:
+#
+#   cp .env.example .env
+#
+# jitera-pentest reads this checkout's .env on every run, from any folder.
+# Variables already set in your shell win over the file, and empty lines are
+# ignored. .env is git-ignored, so your keys are never committed. To use a file
+# somewhere else (for example with the packaged binary), set
+# JITERA_PENTEST_ENV_FILE=/path/to/file in your shell.
+#
+# Settings use the JITERA_PENTEST_ prefix; any upstream STRIX_* setting works
+# with that prefix too (JITERA_PENTEST_IMAGE is STRIX_IMAGE, and so on).
+
+
+# --- Required: the model ------------------------------------------------------
+# Any LiteLLM model id (https://docs.litellm.ai/docs/providers), for example:
+#   openrouter/z-ai/glm-5.3
+#   vercel_ai_gateway/zai/glm-5.3
+#   openai/gpt-5.4
+#   ollama/<model>          (local; also set LLM_API_BASE below)
+#   chatgpt/gpt-5.4         (ChatGPT subscription: run `jitera-pentest auth login chatgpt`
+#                            instead of setting LLM_API_KEY)
+JITERA_PENTEST_LLM=
+
+# API key for that provider.
+LLM_API_KEY=
+
+
+# --- Optional: the model connection -----------------------------------------
+# Base URL for a local or self-hosted model (Ollama, LM Studio, a proxy).
+# LLM_API_BASE=http://localhost:11434
+
+# How hard the model thinks: none, minimal, low, medium, high (default), xhigh, max.
+# JITERA_PENTEST_REASONING_EFFORT=high
+
+# Extra HTTP headers or body fields for every LLM request, as JSON.
+# LLM_EXTRA_HEADERS={"X-Team": "security"}
+
+
+# --- Optional: tools for the agents -----------------------------------------
+# Web search. Either key enables it.
+# PERPLEXITY_API_KEY=
+# EXA_API_KEY=
+
+# Postman, for scanning a Postman collection by id.
+# POSTMAN_API_KEY=
+
+
+# --- Optional: runtime --------------------------------------------------------
+# Sandbox image. Default: upstream's ghcr.io/usestrix/strix-sandbox:1.4.1
+# JITERA_PENTEST_IMAGE=
+
+# Telemetry is off by default. Setting 1 sends anonymous usage data to the
+# upstream Strix vendor.
+# JITERA_PENTEST_TELEMETRY=0
