+"""run_eval checks its settings before scanning. No network, no scan."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+from eval import run_eval
+
+
+if TYPE_CHECKING:
+    import pytest
+
+
+def _stub(
+    monkeypatch: pytest.MonkeyPatch, *, reachable: bool = True, model: str | None = "openai/gpt-5.4"
+) -> None:
+    def no_scan(**_: Any) -> None:
+        msg = "must not start a scan"
+        raise AssertionError(msg)
+
+    monkeypatch.setattr(run_eval, "prepare_settings", lambda: None)
+    monkeypatch.setattr(run_eval, "configured_model", lambda: model)
+    monkeypatch.setattr(
+        run_eval,
+        "check_reachable",
+        lambda _url, timeout=10.0: (reachable, "HTTP 200" if reachable else "HTTP 503"),  # noqa: ARG005
+    )
+    monkeypatch.setattr(run_eval, "run_scan", no_scan)
+
+
+def test_check_reports_target_and_model(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    _stub(monkeypatch)
+    assert run_eval.main(["--check"]) == run_eval.EXIT_OK
+    out = capsys.readouterr().out
+    assert "target  up" in out
+    assert "model   openai/gpt-5.4" in out
+
+
+def test_check_without_a_model_points_at_env_example(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    _stub(monkeypatch, model=None)
+    assert run_eval.main(["--check"]) == run_eval.EXIT_USAGE
+    assert ".env.example" in capsys.readouterr().out
+
+
+def test_check_with_the_target_down(monkeypatch: pytest.MonkeyPatch) -> None:
+    _stub(monkeypatch, reachable=False)
+    assert run_eval.main(["--check"]) == run_eval.EXIT_UNREACHABLE
+
+
+def test_a_scan_without_a_model_stops_before_scanning(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    _stub(monkeypatch, model=None)
+    assert run_eval.main([]) == run_eval.EXIT_USAGE  # run_scan would raise if called
+    assert "JITERA_PENTEST_LLM" in capsys.readouterr().err
