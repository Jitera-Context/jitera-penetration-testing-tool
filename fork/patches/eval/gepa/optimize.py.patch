+"""Optimize the agent's eval instructions with GEPA.
+
+    # Verify the loop with no scans and no LLM (deterministic stubs):
+    uv run --frozen --with gepa==0.1.4 python -m eval.gepa.optimize --dry-run
+
+    # Real optimization (each metric call is a full scan — minutes to hours, $$):
+    export STRIX_LLM=... LLM_API_KEY=...   # plus LLM_API_BASE for a gateway or self-hosted model
+    uv run --frozen --with gepa==0.1.4 python -m eval.gepa.optimize --max-metric-calls 8
+
+Writes the best instruction found to eval/gepa/optimized_instructions.txt.
+"""
+
+# CLI: printing results is this module's job.
+# ruff: noqa: T201
+
+from __future__ import annotations
+
+import argparse
+import sys
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import gepa
+import litellm
+
+from eval._lib import EVAL_DIR, MISSING_MODEL_HELP, Baseline, configured_model, prepare_settings
+from eval.gepa.adapter import COMPONENT, JiteraGEPAAdapter, Rollout, make_tasks, scan_rollout
+from strix.config import load_settings
+
+
+ReflectionLM = Callable[[Any], str]
+
+# The seed mirrors the real engine prompt the gateway sends (intro + depth +
+# keep-moving + rules), tightened with the fixes scan 1 pointed to: breadth
+# across every vulnerability class, file proven impact at once, converge within
+# budget, and time-box rabbit holes. GEPA refines this against category coverage.
+# Goal: find as many real security issues as possible and cover every aspect of
+# the site. Kept general — no target-specific answers, payloads or markers.
+SEED = (
+    "Attempt to enter the system at the authorized target from an external "
+    "attacker's perspective, then expand access. Your goal is to find as many "
+    "real security issues as you can and cover every aspect of the site.\n\n"
+    "Work breadth-first. Map the whole attack surface — every page, endpoint, "
+    "parameter, header, cookie and role, authenticated and not — then test the "
+    "full range of vulnerability classes, not only the easy ones:\n"
+    "- Injection: SQL, NoSQL, command, template (SSTI) and log injection.\n"
+    "- Cross-site scripting: reflected, stored and DOM-based.\n"
+    "- Broken access control: object-level (IDOR), function-level, forced "
+    "browsing, missing authorization.\n"
+    "- Broken authentication and session: weak or default credentials, flawed "
+    "password reset, JWT and token forgery, 2FA bypass.\n"
+    "- Sensitive data and secret exposure: backups, logs, source maps, API keys, "
+    "confidential files and directories.\n"
+    "- Cryptographic issues: weak hashing or encryption, predictable tokens.\n"
+    "- Security misconfiguration: verbose errors, permissive CORS, missing "
+    "security headers, exposed admin or debug features.\n"
+    "- Improper input validation and business-logic abuse: type, length, format "
+    "and range bypasses, negative or manipulated values, workflow abuse.\n"
+    "- Insecure deserialization and unsafe parsing, including XXE.\n"
+    "- Vulnerable and outdated components with known issues.\n"
+    "- Server-side request forgery and open/unvalidated redirects.\n"
+    "- Missing anti-automation: absent rate limiting, brute-force and CAPTCHA "
+    "weaknesses.\n"
+    "- Weak logging and observability that would let an attack go unnoticed.\n\n"
+    "Cover the breadth before chaining any one finding deeper. The moment you "
+    "have evidence that proves impact, file it as a finding; never park a proven "
+    "issue as a follow-up. Record every surface you assess, including the ones "
+    "that come back clean, so the run can say what was covered.\n\n"
+    "Treat your budget and time as finite. Time-box any single sub-task that runs "
+    "long without progress — brute force, cracking, factoring — take the evidence "
+    "you have and move on. Reserve the last of your budget to file every proven "
+    "impact and resolve open items, and converge rather than expanding forever."
+)
+
+DEFAULT_OUT = EVAL_DIR / "gepa" / "optimized_instructions.txt"
+# Dry runs only prove the loop works; keep their stub output out of git.
+DRY_RUN_OUT = EVAL_DIR / "results" / "gepa-dry-run-instructions.txt"
+
+
+def _covered(instructions: str, baseline: Baseline) -> dict[str, Any]:
+    text = instructions.lower()
+    covered, missed = [], []
+    for category in baseline.categories:
+        hit = category.id in text or any(k in text for k in category.keywords)
+        (covered if hit else missed).append(category.id)
+    return {
+        "covered": covered,
+        "missed": missed,
+        "categories_covered": len(covered),
+        "categories_total": len(baseline.categories),
+    }
+
+
+def stub_rollout(baseline: Baseline) -> Rollout:
+    """Deterministic rollout: reward instructions that name more categories.
+
+    No scan, no LLM. Only for verifying the GEPA loop end to end.
+    """
+
+    def rollout(instructions: str, _task: dict[str, Any]) -> tuple[float, dict[str, Any]]:
+        breakdown = _covered(instructions, baseline)
+        total = breakdown["categories_total"] or 1
+        return breakdown["categories_covered"] / total, breakdown
+
+    return rollout
+
+
+def stub_reflection(baseline: Baseline) -> ReflectionLM:
+    """Stand-in reflection LM: proposes an instruction that names every category."""
+    ideal = "Test this web application for: " + "; ".join(
+        f"{c.title} ({c.id})" for c in baseline.categories
+    )
+
+    def reflect(_prompt: Any) -> str:
+        return f"Here is an improved instruction:\n```\n{ideal}\n```"
+
+    return reflect
+
+
+def litellm_reflection(model: str) -> ReflectionLM:
+    """Real reflection LM: ``model`` via litellm.
+
+    When it is the scans' own model, it also uses their key and endpoint
+    (LLM_API_KEY, LLM_API_BASE), which litellm does not read on its own.
+    """
+    llm = load_settings().llm
+    route: dict[str, str] = {}
+    if model == (llm.model or "").strip():
+        route = {k: v for k, v in (("api_key", llm.api_key), ("api_base", llm.api_base)) if v}
+
+    def reflect(prompt: Any) -> str:
+        messages = prompt if isinstance(prompt, list) else [{"role": "user", "content": prompt}]
+        response = litellm.completion(model=model, messages=messages, **route)
+        return str(response.choices[0].message.content)
+
+    return reflect
+
+
+def main(argv: list[str] | None = None) -> int:
+    prepare_settings()  # same .env and settings as the scans
+    parser = argparse.ArgumentParser(prog="eval.gepa.optimize", description=__doc__)
+    parser.add_argument("--baseline", default="juice-shop")
+    parser.add_argument("--target", help="override the baseline target, e.g. a local Juice Shop")
+    parser.add_argument("--dry-run", action="store_true", help="stub scorer + stub LM, no scans")
+    parser.add_argument("--max-metric-calls", type=int, default=6)
+    parser.add_argument("--reflection-model", default=configured_model() or "")
+    parser.add_argument("--seed-file", type=Path, help="start from this instruction file")
+    parser.add_argument("--out", type=Path, help=f"default: {DEFAULT_OUT}")
+    parser.add_argument(
+        "--scan-mode", help="override the baseline scan mode for each GEPA scan, e.g. quick"
+    )
+    parser.add_argument(
+        "--max-budget", type=float, help="override the per-scan USD budget for each GEPA scan"
+    )
+    parser.add_argument(
+        "--timeout-min",
+        type=float,
+        help="stop each scan after this many minutes and score the partial run",
+    )
+    args = parser.parse_args(argv)
+
+    out: Path = args.out or (DRY_RUN_OUT if args.dry_run else DEFAULT_OUT)
+    baseline = Baseline.load(args.baseline)
+    tasks = make_tasks(
+        baseline,
+        args.target,
+        scan_mode=args.scan_mode,
+        max_budget_usd=args.max_budget,
+        timeout_s=args.timeout_min * 60 if args.timeout_min else None,
+    )
+    seed_text = args.seed_file.read_text() if args.seed_file else SEED
+
+    rollout: Rollout
+    reflection: ReflectionLM
+    if args.dry_run:
+        rollout = stub_rollout(baseline)
+        reflection = stub_reflection(baseline)
+    else:
+        if not args.reflection_model:
+            print(f"eval.gepa: {MISSING_MODEL_HELP}", file=sys.stderr)
+            return 2
+        task0 = tasks[0]
+        cap = f", stopped at {args.timeout_min:.0f} min" if args.timeout_min else ""
+        print(
+            f"WARNING: each of up to {args.max_metric_calls} metric calls runs a full scan "
+            f"({task0['scan_mode']} mode, up to ${task0['max_budget_usd']} each{cap}). "
+            "Ctrl-C to abort.",
+            file=sys.stderr,
+        )
+        rollout = scan_rollout(baseline)
+        reflection = litellm_reflection(args.reflection_model)
+
+    adapter = JiteraGEPAAdapter(rollout)
+    result = gepa.optimize(
+        seed_candidate={COMPONENT: seed_text},
+        trainset=tasks,
+        valset=tasks,
+        adapter=adapter,
+        reflection_lm=reflection,
+        max_metric_calls=args.max_metric_calls,
+        display_progress_bar=False,
+        raise_on_exception=True,
+    )
+
+    best = result.best_candidate[COMPONENT]
+    scores = result.val_aggregate_scores
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(best.rstrip() + "\n")
+    print(f"seed score: {scores[0]:.3f}   best score: {max(scores):.3f}")
+    print(f"candidates tried: {len(scores)}   metric calls: {result.total_metric_calls}")
+    print(f"wrote optimized instruction: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
