Title: Installer test expects jitera-pentest in ~/.jitera-pentest/bin
Why: scripts/install.sh is a shell script with no brand profile, so its test follows the Jitera installer.
Upstream-PR: none

diff --git a/tests/test_install_script.py b/tests/test_install_script.py
index 67ca48437c95c3a4316f58e3a1c55f671f7e2893..b519088ea00fdea290649727680094a3158ddc3e 100644
--- a/tests/test_install_script.py
+++ b/tests/test_install_script.py
@@ -24,9 +24,9 @@ def _write_executable(path: Path, content: str) -> None:
 
 
 def _create_release_archive(tmp_path: Path) -> Path:
-    binary_name = f"strix-{RELEASE_VERSION}-{RELEASE_TARGET}"
+    binary_name = f"jitera-pentest-{RELEASE_VERSION}-{RELEASE_TARGET}"
     binary_path = tmp_path / binary_name
-    _write_executable(binary_path, f"#!/bin/sh\nprintf 'strix {RELEASE_VERSION}\\n'\n")
+    _write_executable(binary_path, f"#!/bin/sh\nprintf 'jitera-pentest {RELEASE_VERSION}\\n'\n")
 
     archive_path = tmp_path / f"{binary_name}.tar.gz"
     with tarfile.open(archive_path, "w:gz") as archive:
@@ -123,17 +123,17 @@ def test_installer_downloads_and_runs_linux_arm64_release(tmp_path: Path) -> Non
